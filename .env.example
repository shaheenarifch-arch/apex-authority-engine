NODE_ENV=development
APEX_MODE=draft
# RAMBO gateway (e.g. https://black.getservices.ai) and its BLACK_ACCESS_CODE
RAMBO_URL=http://localhost:8080
RAMBO_API_KEY=
DEFAULT_AUTHOR=GetServices.ai Editorial Team
PUBLIC_BASE_URL=https://getservices.ai

# Optional WordPress publishing. Leave empty to keep draft-only mode.
WORDPRESS_GETSERVICES_URL=
WORDPRESS_GETSERVICES_USERNAME=
WORDPRESS_GETSERVICES_APP_PASSWORD=
WORDPRESS_BLACK_URL=
WORDPRESS_BLACK_USERNAME=
WORDPRESS_BLACK_APP_PASSWORD=
WORDPRESS_STUDIO_URL=
WORDPRESS_STUDIO_USERNAME=
WORDPRESS_STUDIO_APP_PASSWORD=
WORDPRESS_ATLAS_URL=
WORDPRESS_ATLAS_USERNAME=
WORDPRESS_ATLAS_APP_PASSWORD=
WORDPRESS_RELAY_URL=
WORDPRESS_RELAY_USERNAME=
WORDPRESS_RELAY_APP_PASSWORD=

# Optional generic webhook destinations for CMS or social automation.
PUBLISH_WEBHOOK_URL=
SOCIAL_WEBHOOK_URL=
